#!/usr/bin/env sh
# Escape hatches (honored only via --hook): SKIP=pre-push|pre-commit|tests|all
# Also: HUSKY=0 | git push --no-verify
# See README "Pre-push hooks" and scripts/precommit-env.ts.
set -e
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
exec "$ROOT/node_modules/.bin/tsx" "$ROOT/scripts/test-precommit.ts" --hook
